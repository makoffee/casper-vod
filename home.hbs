{{!< default}}

{{#post}}

    {{!-- 1. Standard Header Banner with Site Branding --}}
    <section id="site-header-banner">
        {{#match @custom.publication_cover_style "!=" "None"}}
            <div class="site-header-content{{#match @custom.publication_cover_style "Large"}} large{{/match}}">
                {{#if @site.cover_image}}
                    <img class="site-header-cover"
                        srcset="{{img_url @site.cover_image size="s"}} 300w,
                                {{img_url @site.cover_image size="m"}} 600w,
                                {{img_url @site.cover_image size="l"}} 1000w,
                                {{img_url @site.cover_image size="xl"}} 2000w"
                        sizes="100vw"
                        src="{{img_url @site.cover_image size="xl"}}"
                        alt=""
                    />
                {{/if}}
                <h1 class="site-title">
                    {{#if @site.logo}}
                        <img class="site-logo" src="{{img_url @site.logo size="m"}}" alt="{{@site.title}}" />
                    {{else}}
                        {{@site.title}}
                    {{/if}}
                </h1>
                <p>{{@site.description}}</p>
            </div>
        {{/match}}
    </section>

    <main id="site-main" class="site-main">

        {{!-- 2. Editable Page Content Area (The "Slices") --}}


                <section id="home-page-content">
                    <div {{#if feature_image}} style="background-image: url({{feature_image}}){{/if}}">
                        {{content}}
                    </div>
        </section>

        {{!-- Members Header (from a Page) --}}
        <section id="members-header-full">
            {{#get "pages" filter="tag:#home-slice+slug:home-members-header" limit="1"}}
                {{#foreach pages}}
                    <div class="kg-card kg-header-card kg-width-full kg-size-small kg-style-accent" {{#if feature_image}} style="background-image: url({{feature_image}}); background-size: cover;"{{/if}}>
                        <h2 class="kg-header-card-header">{{title}}</h2>
                        <h3 class="kg-header-card-subheader">{{content}}</h3>
                        {{#get "posts" filter="tag:members" limit="all"}}
                            <div class="inner posts">
                                <div class="post-feed post-card-members invert">
                                    {{#foreach posts}}
                                        {{> "post-image"}}
                                    {{/foreach}}
                                </div>
                            </div>
                        {{/get}}
                    </div>
                {{/foreach}}
            {{/get}}
        </section>

        {{!-- 3. Coalition Members Section (Dynamic Content) --}}
        <section id="coalition-members">
            <div class="kg-card kg-header-card kg-width-full kg-size-small kg-style-accent" style="">
                {{#get "pages" filter="slug:home-members-header+tag:hash-home-slice" limit="1"}}
                    {{#foreach pages}}
                        <h2 class="kg-header-card-header">{{title}}</h2>
                        <h3 class="kg-header-card-subheader">{{content}}</h3>
                    {{/foreach}}
                {{/get}}

                {{!-- Members List (Post Feed) --}}
                {{#get "posts" filter="tag:members" limit="all"}}
                    <div class="inner posts">
                        <div class="post-feed post-card-members invert">
                            {{#foreach posts}}
                                {{> "post-image"}}
                            {{/foreach}}
                        </div>
                    </div>
                {{/get}}

                <a href="/members/" class="kg-header-card-button ghost-button">Learn More</a>
            </div>
        </section>

        {{!-- 4. What We Stand For Section (Dynamic Content) --}}
        <section id="what-we-stand-for">
            {{#get "pages" filter="slug:home-what-we-stand-for+tag:hash-home-slice" limit="1"}}
                {{#foreach pages}}
                    <div {{#if feature_image}} style="background-image: url({{feature_image}}); background-size: cover;"{{/if}}>
                        <div class="inner">
                        {{content}}
                        </div>
                    </div>
                {{/foreach}}
            {{/get}}
        </section>

        {{!-- 5. Featured Priorities Section (Dynamic Content) --}}
        <section class="featured-priorities-container" id="featured-priorities">
            <div class="outer">
            <div class="inner posts">
                <div class="kg-card kg-header-card kg-width-full kg-size-small kg-style-light" style="background:none">
                    {{#get "pages" filter="slug:home-priorities-header+tag:hash-home-slice" limit="1"}}
                        {{#foreach pages}}
                            <h2 class="kg-header-card-header">{{title}}</h2>
                        {{/foreach}}
                    {{/get}}
                </div>

                <div class="post-feed feature">
                    {{#get "posts" filter="featured:true" limit="3"}}
                        {{#foreach posts}}
                            {{> "post-card-feature"}}
                        {{/foreach}}
                    {{/get}}
                </div>
            </div>
            </div>
        </section>

        {{!-- 6. Policy Section (Dynamic Content) --}}
        <section id="why-policy-matters" style="background: linear-gradient(216deg, #361bd8, #f20674) !important;" {{#if feature_image}} style="background-image: url({{feature_image}}){{/if}}">
            {{#get "pages" filter="slug:home-why-policy-matters+tag:hash-home-slice" limit="1"}}
                <div class="inner">
                {{#foreach pages}}
                        {{content}}
                {{/foreach}}
                </div>
            {{/get}}
        </section>
        {{!-- 7. Custom Footer CTA Section (Dynamic Content) --}}
        <section id="home-cta-footer">
            {{#get "pages" filter="slug:home-cta+tag:hash-home-slice" limit="1"}}
                {{#foreach pages}}
                    <div class="kg-card kg-header-card kg-width-full kg-size-small kg-style-image" {{#if feature_image}} style="background-image: url({{feature_image}}){{/if}}">
                        <div class="gh-canvas inner">
                            <h2 class="kg-header-card-header white-space">{{title}}</h2>
                        </div>
                        {{content}}
                    </div>
                {{/foreach}}
            {{/get}}
        </section>

        {{!-- 8. Latest News/Positions Section (Dynamic Content) --}}
        <section id="latest-news-and-positions">
            <aside class="read-more-wrap">
                <div class="read-more inner">
                    {{#get "posts" filter="tag:positions,tag:news" include="authors" limit="3"}}
                        {{#foreach posts}}
                            {{> "post-card-lite"}}
                        {{/foreach}}
                    {{/get}}
                </div>
            </aside>
        </section>

    </main>

{{/post}}